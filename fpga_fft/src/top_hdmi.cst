// Tang Nano 20K pins for the HDMI demo build (top_hdmi.v). The ESP32 UART pins 27/28 are
// not used since 2026-10-29 (the benchmark moved out of this build; see top.cst).
IO_LOC "clk" 4;                 // 27 MHz crystal
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "led[0]" 15;             // on-board LEDs, lit when low
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;

// HDMI (Tang Nano 20K on-board socket; pins from Sipeed's official 20K HDMI example)
IO_LOC "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "tmds_d_p[0]" 35,36;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "tmds_d_p[1]" 37,38;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "tmds_d_p[2]" 39,40;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;

// INMP441 microphone (H3) — header pins 25/26/29 (next to the old ESP32 UART pins 27/28)
IO_LOC "i2s_sck" 25;
IO_PORT "i2s_sck" IO_TYPE=LVCMOS33 DRIVE=8;   // 8 mA: as in top_mic_uart.cst, where the mic is clean
IO_LOC "i2s_ws" 26;
IO_PORT "i2s_ws" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "i2s_sd" 29;
IO_PORT "i2s_sd" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;   // the mic lets SD float in the right-channel half

// the board's two push buttons (read 1 while pressed; pins as in Sipeed's 20K examples)
IO_LOC "btn[0]" 88;
IO_PORT "btn[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "btn[1]" 87;
IO_PORT "btn[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
