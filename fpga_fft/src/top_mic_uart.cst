// Tang Nano 20K pins for the microphone check (top_mic_uart.v)
IO_LOC "clk" 4;                 // 27 MHz crystal
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "uart_tx" 28;            // -> ESP32-S3 GPIO18 (RX)
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;

// INMP441: SCK 25, WS 26, SD 29: the same pins as the HDMI demo (top_hdmi.cst), so the mic
// check and the demo share one wiring. Shared with the LCD connector (no LCD fitted).
// Tried before: 76/74/75 and 73/74/75 (2026-10-14..18), scrambled words.
IO_LOC "i2s_sck" 25;
IO_PORT "i2s_sck" IO_TYPE=LVCMOS33 DRIVE=8;   // 8 mA, as on the Tang Nano 4K where the mic works
IO_LOC "i2s_ws" 26;
IO_PORT "i2s_ws" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "i2s_sd" 29;
IO_PORT "i2s_sd" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;   // the mic lets SD float in the right-channel half

IO_LOC "btn[0]" 88;             // S1: source (test tone / microphone)
IO_PORT "btn[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "btn[1]" 87;             // S2: unused
IO_PORT "btn[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC "led[0]" 15;             // on-board LEDs, lit when low
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;
